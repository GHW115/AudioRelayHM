{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "${env.OHOS_CERT_PATH}",
          "keyAlias": "${env.OHOS_KEY_ALIAS}",
          "keyPassword": "${env.OHOS_KEY_PASSWORD}",
          "profile": "${env.OHOS_PROFILE_PATH}",
          "signAlg": "SHA256withECDSA",
          "storeFile": "${env.OHOS_STORE_FILE}",
          "storePassword": "${env.OHOS_STORE_PASSWORD}"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "6.1.1(24)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          },
          "nativeCompiler": "BiSheng"
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}